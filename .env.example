# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://eksathe:eksathe_dev_password@localhost:5432/eksathe"
# Isolated integration-test database (started by bun run db:test:setup)
TEST_DATABASE_URL="postgresql://eksathe_test:eksathe_test_password@localhost:5433/eksathe_test"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Construction listings and new work require a current contractor/supplier approval by default.
# Set false only for a temporary rollout bypass; profile/capability approvals still apply.
CONSTRUCTION_VERIFICATION_ENFORCED="true"

# Transactional email (verification links and password resets)
RESEND_API_KEY="re_replace-with-a-resend-api-key"
# Resend's demo sender is for local testing; production needs your verified domain.
RESEND_FROM="EKsathe Bangladesh <onboarding@resend.dev>"

# Optional shared rate-limit and Better Auth secondary storage (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Private S3-compatible storage for listing photos and project documents
S3_BUCKET="eksathe-private"
S3_REGION="auto"
S3_ACCESS_KEY_ID="replace-with-storage-access-key"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret"
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO
S3_ENDPOINT=""
