// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id
  name                      String
  email                     String
  emailVerified             Boolean                    @default(false)
  image                     String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  phone                     String
  role                      String                     @default("customer")
  status                    String                     @default("active")
  accountType               String                     @default("customer") @map("account_type")
  sessions                  Session[]
  accounts                  Account[]
  requests                  ServiceRequest[]
  assignedServiceRequests   ServiceRequest[]           @relation("ServiceRequestAssignee")
  serviceRequestUpdates     ServiceRequestUpdate[]
  serviceRequestAttachments ServiceRequestAttachment[]
  auditLogs                 AuditLog[]
  providerProfile           ProviderProfile?
  marketplaceRequests       MarketplaceRequest[]       @relation("RequestBuyer")
  customerOrders            Order[]                    @relation("OrderBuyer")
  constructionProjects      ConstructionProject[]
  staffGrants               StaffGrant[]
  notifications             Notification[]
  submittedPayments         PaymentRecord[]            @relation("PaymentSubmitter")
  reviewedOrders            Review[]                   @relation("ReviewAuthor")
  collectedCommissions      CommissionRecord[]         @relation("CommissionCollector")
  projectDocuments          ProjectDocument[]
  projectPhotos             ProjectPhoto[]
  projectExpenses           ProjectExpense[]
  activityLogs              ActivityLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum RequestStatus {
  NEW       @map("new")
  REVIEWING @map("reviewing")
  ASSIGNED  @map("assigned")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  REJECTED  @map("rejected")

  @@map("request_status")
}

enum ServiceRequestUpdateVisibility {
  CUSTOMER
  INTERNAL
}

enum TransactionStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  REFUNDED @map("refunded")
  FAILED   @map("failed")

  @@map("transaction_status")
}

enum SectorStatus {
  LIVE
  COMING_SOON
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingKind {
  PRODUCE
  WORKER
  MACHINERY
  CONSTRUCTION_MATERIAL
  CONSTRUCTION_SERVICE
}

enum MarketplaceRequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_WALLET
  OTHER
}

enum CommissionStatus {
  DUE
  COLLECTED
  WAIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  APPROVED
}

enum StaffPermission {
  OPERATIONS
  FINANCE
  USERS
  PANELS
  REPORTS
}

model ServiceDefinition {
  id            Int                            @id @default(autoincrement())
  slug          String                         @unique
  category      String
  icon          String                         @default("🌱")
  isActive      Boolean                        @default(true) @map("is_active")
  formVersion   Int                            @default(1) @map("form_version")
  sectorSlug    String                         @default("agriculture-labor") @map("sector_slug")
  createdAt     DateTime                       @default(now()) @map("created_at")
  sector        Sector                         @relation(fields: [sectorSlug], references: [slug])
  requests      ServiceRequest[]
  translations  ServiceDefinitionTranslation[]

  @@map("panels")
}

model ServiceDefinitionTranslation {
  serviceDefinitionId Int               @map("service_definition_id")
  locale              String
  title               String
  description         String
  serviceDefinition   ServiceDefinition @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)

  @@id([serviceDefinitionId, locale])
  @@index([locale])
  @@map("panel_translations")
}

model ServiceRequest {
  id                   Int                        @id @default(autoincrement())
  userId               String?                    @map("user_id")
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceDefinitionId  Int                        @map("panel_id")
  serviceDefinition    ServiceDefinition          @relation(fields: [serviceDefinitionId], references: [id])
  customerName         String                     @map("customer_name")
  phone                String
  district             String
  details              String
  budget               Decimal?                   @db.Decimal(12, 2)
  referenceCode        String?                    @unique @map("reference_code")
  formVersion          Int                        @default(1) @map("form_version")
  answers              Json                       @default("{}")
  fieldSnapshot        Json                       @default("[]") @map("field_snapshot")
  assignedToId         String?                    @map("assigned_to_id")
  assignedTo           User?                      @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  marketplaceRequestId String?                    @unique @map("marketplace_request_id")
  marketplaceRequest   MarketplaceRequest?        @relation(fields: [marketplaceRequestId], references: [id], onDelete: SetNull)
  status               RequestStatus              @default(NEW)
  adminNote            String?                    @map("admin_note")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  transactions         Transaction[]
  updates              ServiceRequestUpdate[]
  attachments          ServiceRequestAttachment[]
  publishedMarketPrice AgricultureMarketPrice?

  @@index([userId])
  @@index([serviceDefinitionId])
  @@index([status])
  @@index([status, district, createdAt])
  @@index([assignedToId, status])
  @@map("service_requests")
}

model ServiceRequestUpdate {
  id           String                            @id @default(cuid())
  requestId    Int                               @map("request_id")
  authorId     String?                           @map("author_id")
  visibility   ServiceRequestUpdateVisibility    @default(CUSTOMER)
  createdAt    DateTime                          @default(now()) @map("created_at")
  request      ServiceRequest                    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User?                             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations ServiceRequestUpdateTranslation[]

  @@index([requestId, visibility, createdAt])
  @@map("service_request_updates")
}

model ServiceRequestUpdateTranslation {
  requestUpdateId String               @map("request_update_id")
  locale          String
  message         String
  requestUpdate   ServiceRequestUpdate @relation(fields: [requestUpdateId], references: [id], onDelete: Cascade)

  @@id([requestUpdateId, locale])
  @@index([locale])
  @@map("service_request_update_translations")
}

model ServiceRequestAttachment {
  id          String         @id @default(cuid())
  requestId   Int            @map("request_id")
  createdById String         @map("created_by_id")
  storageKey  String         @unique @map("storage_key")
  filename    String
  contentType String         @map("content_type")
  sizeBytes   Int            @map("size_bytes")
  createdAt   DateTime       @default(now()) @map("created_at")
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("service_request_attachments")
}

model Transaction {
  id               Int               @id @default(autoincrement())
  requestId        Int?              @map("request_id")
  request          ServiceRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  grossAmount      Decimal           @default(0) @map("gross_amount") @db.Decimal(12, 2)
  commissionRate   Decimal           @default(10.00) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal           @default(0) @map("commission_amount") @db.Decimal(12, 2)
  providerAmount   Decimal           @default(0) @map("provider_amount") @db.Decimal(12, 2)
  status           TransactionStatus @default(PENDING)
  referenceCode    String?           @map("reference_code")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([requestId])
  @@index([status])
  @@map("transactions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?  @map("entity_type")
  entityId   BigInt?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model Sector {
  slug                 String                @id
  position             Int                   @unique
  icon                 String
  status               SectorStatus          @default(COMING_SOON)
  commissionRate       Decimal               @default(10.00) @map("commission_rate") @db.Decimal(5, 2)
  serviceDefinitions   ServiceDefinition[]
  providerCapabilities ProviderCapability[]
  listings             MarketplaceListing[]
  requests             MarketplaceRequest[]
  projects             ConstructionProject[]
  staffGrants          StaffGrant[]
  translations         SectorTranslation[]

  @@map("sectors")
}

model SectorTranslation {
  sectorSlug String @map("sector_slug")
  locale     String
  title      String
  sector     Sector @relation(fields: [sectorSlug], references: [slug], onDelete: Cascade)

  @@id([sectorSlug, locale])
  @@index([locale])
  @@map("sector_translations")
}

model ProviderProfile {
  id              String                       @id @default(cuid())
  userId          String                       @unique @map("user_id")
  district        String
  upazila         String?
  profileImageKey String?                      @map("profile_image_key")
  coverImageKey   String?                      @map("cover_image_key")
  status          ProviderStatus               @default(PENDING)
  reviewedAt      DateTime?                    @map("reviewed_at")
  reviewedById    String?                      @map("reviewed_by_id")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities    ProviderCapability[]
  listings        MarketplaceListing[]
  requests        MarketplaceRequest[]
  orders          Order[]
  reviews         Review[]
  milestones      ProjectMilestone[]           @relation("MilestoneProvider")
  translations    ProviderProfileTranslation[]

  @@index([status])
  @@index([district])
  @@map("provider_profiles")
}

model ProviderProfileTranslation {
  providerId String          @map("provider_id")
  locale     String
  name       String
  bio        String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([providerId, locale])
  @@index([locale])
  @@map("provider_profile_translations")
}

model ProviderCapability {
  id           Int             @id @default(autoincrement())
  providerId   String          @map("provider_id")
  sectorSlug   String          @map("sector_slug")
  kind         ListingKind
  status       ProviderStatus  @default(PENDING)
  reviewedAt   DateTime?       @map("reviewed_at")
  reviewedById String?         @map("reviewed_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sector       Sector          @relation(fields: [sectorSlug], references: [slug])

  @@unique([providerId, sectorSlug, kind])
  @@index([sectorSlug, status])
  @@map("provider_capabilities")
}

model StaffGrant {
  id         Int             @id @default(autoincrement())
  userId     String          @map("user_id")
  scopeKey   String          @map("scope_key")
  sectorSlug String?         @map("sector_slug")
  permission StaffPermission
  createdAt  DateTime        @default(now()) @map("created_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector     Sector?         @relation(fields: [sectorSlug], references: [slug])

  @@unique([userId, permission, scopeKey])
  @@index([userId, permission])
  @@map("staff_grants")
}

model MarketplaceListing {
  id                       String                          @id @default(cuid())
  providerId               String                          @map("provider_id")
  sectorSlug               String                          @map("sector_slug")
  kind                     ListingKind
  category                 String
  district                 String
  unit                     String
  unitPrice                Decimal                         @map("unit_price") @db.Decimal(12, 2)
  stock                    Decimal                         @default(0) @db.Decimal(12, 3)
  availableFrom            DateTime?                       @map("available_from")
  imageKey                 String?                         @map("image_key")
  archivedAt               DateTime?                       @map("archived_at")
  moderationStatus         ListingModerationStatus         @default(PENDING) @map("moderation_status")
  isPublished              Boolean                         @default(false) @map("is_published")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  provider                 ProviderProfile                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sector                   Sector                          @relation(fields: [sectorSlug], references: [slug])
  requests                 MarketplaceRequest[]
  orders                   Order[]
  preferredProjectPackages ProjectPackage[]                @relation("PreferredProjectListing")
  translations             MarketplaceListingTranslation[]

  @@index([sectorSlug, kind, isPublished, archivedAt])
  @@index([district, isPublished])
  @@index([category, isPublished])
  @@map("marketplace_listings")
}

model MarketplaceListingTranslation {
  listingId   String             @map("listing_id")
  locale      String
  title       String
  description String
  listing     MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, locale])
  @@index([locale])
  @@map("marketplace_listing_translations")
}

model MarketplaceRequest {
  id             String                   @id @default(cuid())
  buyerId        String                   @map("buyer_id")
  providerId     String                   @map("provider_id")
  listingId      String                   @map("listing_id")
  sectorSlug     String                   @map("sector_slug")
  projectId      String?                  @map("project_id")
  packageId      String?                  @map("package_id")
  packageLabel   String?                  @map("package_label")
  quantity       Decimal                  @db.Decimal(12, 3)
  district       String
  details        String                   @default("")
  requestedStart DateTime?                @map("requested_start")
  requestedEnd   DateTime?                @map("requested_end")
  status         MarketplaceRequestStatus @default(OPEN)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  buyer          User                     @relation("RequestBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  provider       ProviderProfile          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  listing        MarketplaceListing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  sector         Sector                   @relation(fields: [sectorSlug], references: [slug])
  project        ConstructionProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPackage ProjectPackage?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quote          Quote?
  order          Order?
  serviceRequest ServiceRequest?

  @@index([buyerId, status])
  @@index([providerId, status])
  @@index([sectorSlug, status])
  @@map("marketplace_requests")
}

model Quote {
  id           String             @id @default(cuid())
  requestId    String             @unique @map("request_id")
  quantity     Decimal            @db.Decimal(12, 3)
  unitPrice    Decimal            @map("unit_price") @db.Decimal(12, 2)
  transportFee Decimal            @default(0) @map("transport_fee") @db.Decimal(12, 2)
  note         String             @default("")
  expiresAt    DateTime?          @map("expires_at")
  acceptedAt   DateTime?          @map("accepted_at")
  status       QuoteStatus        @default(PENDING)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  request      MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order        Order?

  @@map("quotes")
}

model Order {
  id                  String               @id @default(cuid())
  requestId           String               @unique @map("request_id")
  quoteId             String               @unique @map("quote_id")
  buyerId             String               @map("buyer_id")
  providerId          String               @map("provider_id")
  listingId           String               @map("listing_id")
  projectId           String?              @map("project_id")
  packageId           String?              @map("package_id")
  packageLabel        String?              @map("package_label")
  quantity            Decimal              @db.Decimal(12, 3)
  unit                String
  unitPrice           Decimal              @map("unit_price") @db.Decimal(12, 2)
  subtotal            Decimal              @db.Decimal(12, 2)
  transportFee        Decimal              @default(0) @map("transport_fee") @db.Decimal(12, 2)
  commissionRate      Decimal              @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount    Decimal              @map("commission_amount") @db.Decimal(12, 2)
  providerAmount      Decimal              @map("provider_amount") @db.Decimal(12, 2)
  status              OrderStatus          @default(CONFIRMED)
  cancellationReason  String?              @map("cancellation_reason")
  cancelRequestedById String?              @map("cancel_requested_by_id")
  cancelRequestedAt   DateTime?            @map("cancel_requested_at")
  cancelConfirmedAt   DateTime?            @map("cancel_confirmed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  request             MarketplaceRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  buyer               User                 @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  provider            ProviderProfile      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  listing             MarketplaceListing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  project             ConstructionProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPackage      ProjectPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  booking             Booking?
  payments            PaymentRecord[]
  commission          CommissionRecord?
  review              Review?

  @@index([buyerId, status])
  @@index([providerId, status])
  @@index([projectId])
  @@map("orders")
}

model Booking {
  id       String   @id @default(cuid())
  orderId  String   @unique @map("order_id")
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@map("bookings")
}

model PaymentRecord {
  id                  String        @id @default(cuid())
  orderId             String        @map("order_id")
  submittedById       String        @map("submitted_by_id")
  amount              Decimal       @db.Decimal(12, 2)
  method              PaymentMethod
  reference           String?
  paidAt              DateTime      @map("paid_at")
  buyerConfirmedAt    DateTime?     @map("buyer_confirmed_at")
  providerConfirmedAt DateTime?     @map("provider_confirmed_at")
  refundAmount        Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  refundedAt          DateTime?     @map("refunded_at")
  refundReference     String?       @map("refund_reference")
  receiptKey          String?       @unique @map("receipt_key")
  createdAt           DateTime      @default(now()) @map("created_at")
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedBy         User          @relation("PaymentSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([buyerConfirmedAt, providerConfirmedAt])
  @@map("payment_records")
}

model CommissionRecord {
  id            String           @id @default(cuid())
  orderId       String           @unique @map("order_id")
  amount        Decimal          @db.Decimal(12, 2)
  status        CommissionStatus @default(DUE)
  reference     String?
  collectedById String?          @map("collected_by_id")
  collectedAt   DateTime?        @map("collected_at")
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  collectedBy   User?            @relation("CommissionCollector", fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([status, collectedAt])
  @@map("commission_records")
}

model Review {
  id         String          @id @default(cuid())
  orderId    String          @unique @map("order_id")
  reviewerId String          @map("reviewer_id")
  providerId String          @map("provider_id")
  rating     Int
  comment    String          @default("")
  createdAt  DateTime        @default(now()) @map("created_at")
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer   User            @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@map("reviews")
}

model ConstructionProject {
  id              String               @id @default(cuid())
  ownerId         String               @map("owner_id")
  sectorSlug      String               @default("construction") @map("sector_slug")
  title           String
  projectType     String               @map("project_type")
  district        String
  description     String               @db.Text
  approximateArea String?              @map("approximate_area")
  budget          Decimal?             @db.Decimal(12, 2)
  startsAt        DateTime?            @map("starts_at")
  targetEndsAt    DateTime?            @map("target_ends_at")
  handedOverAt    DateTime?            @map("handed_over_at")
  status          ProjectStatus        @default(PLANNING)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sector          Sector               @relation(fields: [sectorSlug], references: [slug])
  requests        MarketplaceRequest[]
  orders          Order[]
  packages        ProjectPackage[]
  milestones      ProjectMilestone[]
  documents       ProjectDocument[]
  photos          ProjectPhoto[]
  expenses        ProjectExpense[]

  @@index([ownerId, status])
  @@map("construction_projects")
}

model ProjectPackage {
  id                 String               @id @default(cuid())
  projectId          String               @map("project_id")
  label              String
  description        String               @default("")
  kind               ListingKind?
  serviceSlug        String?              @map("service_slug")
  preferredListingId String?              @map("preferred_listing_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  project            ConstructionProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preferredListing   MarketplaceListing?  @relation("PreferredProjectListing", fields: [preferredListingId], references: [id], onDelete: SetNull)
  requests           MarketplaceRequest[]
  orders             Order[]

  @@unique([projectId, label])
  @@index([projectId, createdAt])
  @@map("project_packages")
}

model ProjectMilestone {
  id                 String              @id @default(cuid())
  projectId          String              @map("project_id")
  assignedProviderId String?             @map("assigned_provider_id")
  title              String
  description        String              @default("")
  amount             Decimal?            @db.Decimal(12, 2)
  dueAt              DateTime?           @map("due_at")
  status             MilestoneStatus     @default(PENDING)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  project            ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedProvider   ProviderProfile?    @relation("MilestoneProvider", fields: [assignedProviderId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("project_milestones")
}

model ProjectPhoto {
  id           String              @id @default(cuid())
  projectId    String              @map("project_id")
  uploadedById String              @map("uploaded_by_id")
  filename     String
  storageKey   String              @unique @map("storage_key")
  contentType  String              @map("content_type")
  sizeBytes    Int                 @map("size_bytes")
  createdAt    DateTime            @default(now()) @map("created_at")
  project      ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("project_photos")
}

model ProjectDocument {
  id           String              @id @default(cuid())
  projectId    String              @map("project_id")
  uploadedById String              @map("uploaded_by_id")
  filename     String
  storageKey   String              @unique @map("storage_key")
  contentType  String              @map("content_type")
  sizeBytes    Int                 @map("size_bytes")
  createdAt    DateTime            @default(now()) @map("created_at")
  project      ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("project_documents")
}

model ProjectExpense {
  id          String              @id @default(cuid())
  projectId   String              @map("project_id")
  createdById String              @map("created_by_id")
  description String
  amount      Decimal             @db.Decimal(12, 2)
  occurredAt  DateTime            @map("occurred_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  project     ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, occurredAt])
  @@map("project_expenses")
}

model Notification {
  id           String                    @id @default(cuid())
  userId       String                    @map("user_id")
  title        String
  message      String
  href         String?
  readAt       DateTime?                 @map("read_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  translations NotificationTranslation[]

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationTranslation {
  notificationId String       @map("notification_id")
  locale         String
  title          String?
  message        String?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, locale])
  @@index([locale])
  @@map("notification_translations")
}

enum AgriculturePublicationStatus {
  DRAFT
  PUBLISHED
}

enum AgricultureUpdateKind {
  NEWS
  ADVICE
  WEATHER_ALERT
}

model AgricultureMarketPrice {
  id              String                              @id @default(cuid())
  market          String
  district        String
  unit            String
  price           Decimal                             @db.Decimal(12, 2)
  observedAt      DateTime                            @map("observed_at")
  source          String
  status          AgriculturePublicationStatus        @default(DRAFT)
  sourceRequestId Int?                                @unique @map("source_request_id")
  sourceRequest   ServiceRequest?                     @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)
  createdAt       DateTime                            @default(now()) @map("created_at")
  updatedAt       DateTime                            @updatedAt @map("updated_at")
  translations    AgricultureMarketPriceTranslation[]

  @@index([status, observedAt])
  @@map("agriculture_market_prices")
}

model AgricultureMarketPriceTranslation {
  marketPriceId String                 @map("market_price_id")
  locale        String
  product       String
  marketPrice   AgricultureMarketPrice @relation(fields: [marketPriceId], references: [id], onDelete: Cascade)

  @@id([marketPriceId, locale])
  @@index([locale])
  @@map("agriculture_market_price_translations")
}

model AgricultureUpdate {
  id           String                         @id @default(cuid())
  kind         AgricultureUpdateKind
  source       String
  status       AgriculturePublicationStatus   @default(DRAFT)
  publishedAt  DateTime                       @map("published_at")
  expiresAt    DateTime?                      @map("expires_at")
  createdAt    DateTime                       @default(now()) @map("created_at")
  updatedAt    DateTime                       @updatedAt @map("updated_at")
  translations AgricultureUpdateTranslation[]

  @@index([status, publishedAt, expiresAt])
  @@map("agriculture_updates")
}

model AgricultureUpdateTranslation {
  updateId String            @map("update_id")
  locale   String
  title    String
  body     String
  update   AgricultureUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@id([updateId, locale])
  @@index([locale])
  @@map("agriculture_update_translations")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
