{
  "name": "eksathe-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsrs --noEmit --fast",
    "test:unit": "bun test src/lib prisma/scripts/test-database.test.ts",
    "test:integration": "bun prisma/scripts/test-database.ts test",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U eksathe -d eksathe",
    "db:reset": "docker compose down -v && docker compose up -d --wait && prisma migrate deploy && prisma db seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "bun prisma/deploy.ts",
    "db:seed": "prisma db seed",
    "db:seed:demo": "bun prisma/seed-demo.ts",
    "db:test:setup": "bun prisma/scripts/test-database.ts setup",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "admin:bootstrap": "bun prisma/bootstrap-admin.ts",
    "setup": "bun run db:up && bun run db:migrate && bun run db:seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^9.3.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/parser": "7.29.12",
    "@formatjs/icu-messageformat-parser": "^3.5.18",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.4.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.92.0",
    "oxlint-tailwindcss": "^1.17.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsrs": "^0.23.0-ts7.1.0-beta"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
